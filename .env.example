# Local Travel Guide Generator Environment Configuration
# Copy this file to .env and customize as needed. Never commit .env.

# Model & LoRA Adapter Configuration
BASE_MODEL_NAME=gpt2
LORA_ADAPTER_DIR=models/lora_adapter
MERGED_MODEL_DIR=models/merged_model

# Dataset & Persistence Settings
DATA_PATH=data/app.json
DATASET_PATH=data/travel_dataset.json

# Optional Fallback Chat Settings
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
